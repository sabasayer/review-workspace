{
  "name": "review-workspace",
  "version": "1.3.0",
  "description": "A local, offline decision surface for reviewing a code Comparison — evidence-linked map of intent, behavior, risk, and observable effects.",
  "license": "MIT",
  "author": "Salih Sayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabasayer/review-workspace.git"
  },
  "homepage": "https://github.com/sabasayer/review-workspace#readme",
  "bugs": {
    "url": "https://github.com/sabasayer/review-workspace/issues"
  },
  "keywords": [
    "code-review",
    "cli",
    "pull-request",
    "merge-request",
    "diff"
  ],
  "type": "module",
  "bin": {
    "review-workspace": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "ui-dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:ui": "cd ui && pnpm install && pnpm build && rm -rf ../ui-dist && mv dist ../ui-dist",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build && pnpm build:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.0.0",
    "semantic-release": "^25.0.8",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
